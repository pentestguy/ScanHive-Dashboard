DATABASE_URL=postgresql://opensec:opensec@postgres:5432/opensec

# Browser application URL, used to build links sent in invitation emails.
FRONTEND_URL=http://localhost

# Optional: SMTP delivery for invitation emails. Leave SMTP_HOST blank to
# disable email sending -- invitations still work, and the invite link can
# be copied and shared manually from Settings -> Users.
#
# For local testing without a real mail provider, run
# `docker compose --profile mail-testing up -d` and use:
#   SMTP_HOST=mailpit
#   SMTP_PORT=1025
#   SMTP_USE_TLS=false
# then read caught mail at http://localhost:8025 (no login).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ScanHive
SMTP_USE_TLS=true
