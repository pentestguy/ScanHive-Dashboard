# OS
.DS_Store
**/.DS_Store
Thumbs.db

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment files -- never commit secrets or machine-specific config
.env

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Node / frontend build output
node_modules
dist
dist-ssr
*.local

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Runtime SARIF uploads -- keep the directory, not its contents
backend/app/uploads/*
!backend/app/uploads/.gitkeep
